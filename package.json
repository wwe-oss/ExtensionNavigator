{
  "name": "extension-navigator",
  "publisher": "wayne",
  "displayName": "Extension Navigator & Notes",
  "description": "Navigate VS Code extensions with profiles, notes/tags, daily usage (60s sampling), error sightings, and workspace recommendations.",
  "version": "0.0.6",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:extNavigator.view",
    "onCommand:extNavigator.setFilter",
    "onCommand:extNavigator.clearFilter",
    "onCommand:extNavigator.like",
    "onCommand:extNavigator.dislike",
    "onCommand:extNavigator.clearSentiment",
    "onCommand:extNavigator.openDetails",
    "onCommand:extNavigator.addTag",
    "onCommand:extNavigator.removeTag",
    "onCommand:extNavigator.openMarketplace",
    "onCommand:extNavigator.copyExtensionId",
    "onCommand:extNavigator.copyRepoUrl"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extNavigatorContainer",
          "title": "Extensions+",
          "icon": "media/view-icon.svg"
        }
      ]
    },
    "views": {
      "extNavigatorContainer": [
        {
          "id": "extNavigator.view",
          "name": "Navigator"
        }
      ]
    },
    "commands": [
      {
        "command": "extNavigator.openDetails",
        "title": "Open Profile"
      },
      {
        "command": "extNavigator.like",
        "title": "Like"
      },
      {
        "command": "extNavigator.dislike",
        "title": "Dislike"
      },
      {
        "command": "extNavigator.clearSentiment",
        "title": "Clear Sentiment"
      },
      {
        "command": "extNavigator.addTag",
        "title": "Add Tag..."
      },
      {
        "command": "extNavigator.removeTag",
        "title": "Remove Tag..."
      },
      {
        "command": "extNavigator.setFilter",
        "title": "Filter..."
      },
      {
        "command": "extNavigator.clearFilter",
        "title": "Clear Filter"
      },
      {
        "command": "extNavigator.openMarketplace",
        "title": "Open in Marketplace"
      },
      {
        "command": "extNavigator.copyExtensionId",
        "title": "Copy Extension ID"
      },
      {
        "command": "extNavigator.copyRepoUrl",
        "title": "Copy Repo URL"
      }
    ],
    "menus": {
      "view/title": [
        {
          "when": "view == extNavigator.view && !extnav.filterActive",
          "command": "extNavigator.setFilter",
          "group": "navigation@0"
        },
        {
          "when": "view == extNavigator.view && extnav.filterActive",
          "command": "extNavigator.clearFilter",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.openDetails",
          "group": "navigation@0"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.like",
          "group": "inline@1"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.dislike",
          "group": "inline@2"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.clearSentiment",
          "group": "inline@3"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.addTag",
          "group": "tags@1"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.removeTag",
          "group": "tags@2"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.openMarketplace",
          "group": "quick@1"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.copyExtensionId",
          "group": "quick@2"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.copyRepoUrl",
          "group": "quick@3"
        }
      ]
    },
    "configuration": {
      "title": "Extension Navigator",
      "properties": {
        "extensionNavigator.samplingPeriodMs": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "description": "Usage sampling period in milliseconds (default 60s)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "echo Tests disabled for now. && exit 0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.106.0",
    "typescript": "^5.6.3"
  }
}