{
  "name": "extension-navigator",
  "publisher": "wayne",
  "displayName": "Extension Navigator & Notes",
  "description": "Navigate VS Code extensions with profiles, notes/tags, daily usage (60s sampling), error sightings, and workspace recommendations.",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/view-icon.svg",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:extNavigator.view",
    "onCommand:extNavigator.openDetails",
    "onCommand:extNavigator.discoverLogs"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extNavigatorContainer",
          "title": "Extensions+",
          "icon": "media/view-icon.svg"
        }
      ]
    },
    "views": {
      "extNavigatorContainer": [
        {
          "id": "extNavigator.view",
          "name": "Navigator"
        }
      ]
    },
    "commands": [
      {
        "command": "extNavigator.openDetails",
        "title": "Open Profile"
      },
      {
        "command": "extNavigator.like",
        "title": "Like"
      },
      {
        "command": "extNavigator.dislike",
        "title": "Dislike"
      },
      {
        "command": "extNavigator.clearSentiment",
        "title": "Clear Sentiment"
      },
      {
        "command": "extNavigator.uninstallAsLiked",
        "title": "Uninstall (Liked)"
      },
      {
        "command": "extNavigator.uninstallAsDisliked",
        "title": "Uninstall (Disliked)"
      },
      {
        "command": "extNavigator.disableAsLiked",
        "title": "Disable (Liked)"
      },
      {
        "command": "extNavigator.disableAsDisliked",
        "title": "Disable (Disliked)"
      },
      {
        "command": "extNavigator.addToWorkspaceRecommendations",
        "title": "Add to Workspace Recs"
      },
      {
        "command": "extNavigator.removeFromWorkspaceRecommendations",
        "title": "Remove from Workspace Recs"
      },
      {
        "command": "extNavigator.exportCatalog",
        "title": "Export Catalog"
      },
      {
        "command": "extNavigator.importCatalog",
        "title": "Import Catalog"
      },
      {
        "command": "extNavigator.discoverLogs",
        "title": "Discover Extension Host Logs"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "when": "view == extNavigator.view && viewItem == extension",
          "command": "extNavigator.openDetails",
          "group": "navigation@0"
        },
        {
          "when": "view == extNavigator.view && viewItem == extension",
          "command": "extNavigator.like",
          "group": "inline@1"
        },
        {
          "when": "view == extNavigator.view && viewItem == extension",
          "command": "extNavigator.dislike",
          "group": "inline@2"
        },
        {
          "when": "view == extNavigator.view && viewItem == extension",
          "command": "extNavigator.clearSentiment",
          "group": "inline@3"
        },
        {
          "when": "view == extNavigator.view && viewItem == extension",
          "command": "extNavigator.uninstallAsLiked",
          "group": "2_mod@1"
        },
        {
          "when": "view == extNavigator.view && viewItem == extension",
          "command": "extNavigator.uninstallAsDisliked",
          "group": "2_mod@2"
        },
        {
          "when": "view == extNavigator.view && viewItem == extension",
          "command": "extNavigator.disableAsLiked",
          "group": "2_mod@3"
        },
        {
          "when": "view == extNavigator.view && viewItem == extension",
          "command": "extNavigator.disableAsDisliked",
          "group": "2_mod@4"
        }
      ],
      "view/title": [
        {
          "when": "view == extNavigator.view",
          "command": "extNavigator.discoverLogs",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Extension Navigator",
      "properties": {
        "extensionNavigator.samplingPeriodMs": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "description": "Usage sampling period in milliseconds (default 60s)."
        },
        "extensionNavigator.errorParsing": {
          "type": "string",
          "enum": [
            "simple",
            "off"
          ],
          "default": "simple",
          "description": "Enable simple error parsing from Extension Host logs."
        },
        "extensionNavigator.maxRecentErrors": {
          "type": "number",
          "default": 20,
          "description": "Max recent error messages kept per extension."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.1",
    "@types/vscode": "^1.106.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.1",
    "glob": "^13.0.0",
    "mocha": "^11.7.5",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3"
  }
}
