{
  "name": "extension-navigator",
  "publisher": "wayne",
  "displayName": "Extension Navigator & Notes",
  "description": "Navigator with notes, filter, usage sampling, and self-check diagnostics.",
  "version": "0.0.7",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:extNavigator.view",
    "onCommand:extNavigator.setFilter",
    "onCommand:extNavigator.clearFilter",
    "onCommand:extNavigator.like",
    "onCommand:extNavigator.dislike",
    "onCommand:extNavigator.clearSentiment",
    "onCommand:extNavigator.openDetails",
    "onCommand:extNavigator.copyExtensionId",
    "onCommand:extNavigator.openMarketplace",
    "onCommand:extNavigator.selfCheck"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extNavigatorContainer",
          "title": "Extensions+",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "extNavigatorContainer": [
        {
          "id": "extNavigator.view",
          "name": "Navigator"
        }
      ]
    },
    "commands": [
      {
        "command": "extNavigator.openDetails",
        "title": "Open Profile"
      },
      {
        "command": "extNavigator.like",
        "title": "Like"
      },
      {
        "command": "extNavigator.dislike",
        "title": "Dislike"
      },
      {
        "command": "extNavigator.clearSentiment",
        "title": "Clear Sentiment"
      },
      {
        "command": "extNavigator.setFilter",
        "title": "Filter..."
      },
      {
        "command": "extNavigator.clearFilter",
        "title": "Clear Filter"
      },
      {
        "command": "extNavigator.copyExtensionId",
        "title": "Copy Extension ID"
      },
      {
        "command": "extNavigator.openMarketplace",
        "title": "Open in Marketplace"
      },
      {
        "command": "extNavigator.selfCheck",
        "title": "Extensions+: Run Self-Check"
      }
    ],
    "menus": {
      "view/title": [
        {
          "when": "view == extNavigator.view && !extnav.filterActive",
          "command": "extNavigator.setFilter",
          "group": "navigation@0"
        },
        {
          "when": "view == extNavigator.view && extnav.filterActive",
          "command": "extNavigator.clearFilter",
          "group": "navigation@0"
        },
        {
          "when": "view == extNavigator.view",
          "command": "extNavigator.selfCheck",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.openDetails",
          "group": "navigation@0"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.like",
          "group": "inline@1"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.dislike",
          "group": "inline@2"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.clearSentiment",
          "group": "inline@3"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.copyExtensionId",
          "group": "quick@1"
        },
        {
          "when": "view == extNavigator.view && (viewItem == ext-item || viewItem == ext-builtIn)",
          "command": "extNavigator.openMarketplace",
          "group": "quick@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "echo Tests disabled. && exit 0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.106.0",
    "typescript": "^5.6.3"
  }
}